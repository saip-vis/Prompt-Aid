{
  "name": "prompt-aid",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A review card and MCP tool for refining coding prompts.",
  "scripts": {
    "start": "node server.mjs",
    "preview": "node preview.mjs",
    "test": "node --test test/*.test.mjs",
    "service": "python3 -m backend.app",
    "test:python": "python3 -m unittest discover -s test -p \"test_*.py\" -v",
    "test:native": "swift test",
    "build:native": "./native/build.sh",
    "build:workspace": "python3 skill/prompt-aid/review.py build",
    "test:sdk": "tsc -p sdk/typescript/tsconfig.json && node --test sdk/typescript/client.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
